# EC2 의 deploy/.env 로 복사해서 값을 채운다: cp .env.example .env
# .env 는 비밀값이 들어가므로 절대 커밋하지 않는다 (.gitignore 대상).

# Caddy 가 HTTPS 인증서를 받을 서버 주소
DOMAIN=api.kkobak-med.click

# PostgreSQL (컨테이너 안에서만 쓰는 DB, 밖으로 열지 않음)
POSTGRES_DB=kkobak
POSTGRES_USER=kkobak
# openssl rand -base64 32 로 만든 값
POSTGRES_PASSWORD=change-me

# Spring 서버
GOOGLE_CLIENT_ID=777795391036-af5hi507ond2c56fiffstp50lcsl2p4s.apps.googleusercontent.com
# openssl rand -base64 48 로 만든 값 (Railway 에서 쓰던 값을 그대로 쓰면 기존 로그인 유지)
JWT_SECRET=change-me
ALLOWED_ORIGINS=https://kkobak-med.vercel.app
